# Application
APP_NAME=TrazApp
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
POSTGRES_USER=trazapp
POSTGRES_PASSWORD=trazapp_dev_password
POSTGRES_DB=trazapp
POSTGRES_HOST=database
POSTGRES_PORT=5432

# SQLAlchemy connection string (used by backend)
# In Docker Compose, host is the service name "database"
DATABASE_URL=postgresql+psycopg2://trazapp:trazapp_dev_password@database:5432/trazapp

# Isolated PostgreSQL database for integration tests (RT-01)
TEST_DATABASE_URL=postgresql+psycopg2://trazapp:trazapp_dev_password@database:5432/trazapp_test

# JWT access tokens (do not commit real production secrets)
JWT_SECRET_KEY=change-me-dev-only-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
