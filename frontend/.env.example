# Base URL de la API FastAPI (se embebe en el build de Vite).
#
# Desarrollo local (frontend/.env):
VITE_API_URL=http://localhost:8000
#
# Producción en Netlify (Site settings → Environment variables):
#   Key:   VITE_API_URL
#   Value: https://api.tudominio.cl
#   Scopes: Production (y Preview si aplica)
# Sin barra final. El backend debe incluir el origen Netlify en CORS_ORIGINS.
