# =============================================================================
# TrazApp — variables de entorno (plantilla)
# =============================================================================
# Copiar a `.env` en el servidor/VPS (no versionar secretos reales).
#
# Arquitectura HT01 (Sprint 1):
#   - Frontend React/Vite  → Netlify
#   - Backend FastAPI      → VPS Ubuntu + Docker Compose (este repo)
#   - PostgreSQL           → Docker (servicio `database`)
#   - Reverse proxy        → Caddy (posterior; no incluido aquí)
#
# El frontend YA NO se ejecuta como servicio Docker en este compose.
# =============================================================================


# -----------------------------
# Application
# -----------------------------
APP_NAME=TrazApp

# development | production
# Producción (VPS): APP_ENV=production
APP_ENV=development

API_HOST=0.0.0.0
API_PORT=8000


# -----------------------------
# Frontend (Netlify / Vite)
# -----------------------------
# VITE_API_URL se usa en el BUILD del frontend (Netlify Environment Variables
# o `frontend/.env` en local). No la consume el contenedor backend.
#
# Desarrollo local (Vite en la máquina del desarrollador):
VITE_API_URL=http://localhost:8000
#
# Producción (Netlify) — URL PÚBLICA de la API (después de Caddy, por ejemplo):
# VITE_API_URL=https://api.tudominio.cl


# -----------------------------
# CORS (backend FastAPI)
# -----------------------------
# Orígenes del navegador permitidos (coma-separados, sin espacios raros).
# Debe coincidir con el origen real del frontend.
#
# Desarrollo local (Vite):
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
#
# Producción (Netlify) — obligatorio cambiar:
# CORS_ORIGINS=https://tu-app.netlify.app
# Con dominio custom:
# CORS_ORIGINS=https://tu-app.netlify.app,https://tudominio.cl


# -----------------------------
# PostgreSQL (Docker Compose)
# -----------------------------
POSTGRES_USER=trazapp_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=trazapp_db

# Nombre del servicio Compose en la red Docker:
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Conexión usada por FastAPI / Alembic (obligatoria).
# En Compose, el host es el nombre del servicio `database`.
DATABASE_URL=postgresql+psycopg2://trazapp_user:change_me@database:5432/trazapp_db


# -----------------------------
# Testing (solo desarrollo)
# -----------------------------
TEST_DATABASE_URL=postgresql+psycopg2://trazapp_user:change_me@database:5432/trazapp_test


# -----------------------------
# Authentication (JWT)
# -----------------------------
# Producción: reemplazar por un secreto largo y aleatorio.
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# -----------------------------
# Uploads (imágenes de productos)
# -----------------------------
# Ruta dentro del contenedor backend (volumen Docker `product_uploads`).
UPLOADS_ROOT=/uploads
