# TrazApp — variables de producción (VPS). Copia este archivo a .env.production y completa los valores.
# .env.production NO se sube al repositorio (está en .gitignore). Nunca pongas valores reales aquí.

# --- Aplicación ---
APP_NAME=TrazApp
# "production" apaga /docs, /redoc y /openapi.json.
APP_ENV=production

# --- Dominio del VPS (Caddy y Let's Encrypt) ---
# <IP-con-guiones>.sslip.io, por ejemplo 203-0-113-10.sslip.io. Si Let's Encrypt lo rechaza por límite de
# emisión, usa un subdominio de DuckDNS. Debe coincidir con el dominio del rewrite en frontend/netlify.toml.
DOMINIO=

# --- Base de datos (servicio "database", solo en la red interna de Docker) ---
POSTGRES_USER=
# Contraseña larga y aleatoria, por ejemplo: openssl rand -base64 32 (sin "@", ":" ni "/", que rompen la URL).
POSTGRES_PASSWORD=
POSTGRES_DB=
# postgresql+psycopg2://<POSTGRES_USER>:<POSTGRES_PASSWORD>@database:5432/<POSTGRES_DB>
DATABASE_URL=

# --- Autenticación ---
# Obligatoria: sin ella el código usa un valor de desarrollo inseguro. Genérala con: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Navegador ---
# El navegador habla con Netlify (mismo origen), pero se deja el origen del sitio por si se llama directo.
CORS_ORIGINS=https://trazapp.netlify.app
# Base de la ficha pública y del QR: {URL_PUBLICA_APP}/p/{id_publico}. Es la URL del frontend, no la del VPS.
URL_PUBLICA_APP=https://trazapp.netlify.app

# --- Archivos ---
# Imágenes de productos, en el volumen product_uploads.
UPLOADS_ROOT=/uploads
